+std::map<QString, Fooyin::Track> tracksByPath(const Fooyin::TrackList& tracks)
+{
+    std::map<QString, Fooyin::Track> result;
+    for(const auto& track : tracks) {
+        result.emplace(track.filepath(), track);
+    }
+    return result;
+}
