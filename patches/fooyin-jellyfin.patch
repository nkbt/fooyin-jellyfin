+    ASSERT_TRUE(pumpUntil([&]() { return harness.engine.trackStatus() == Engine::TrackStatus::Loaded; }));
+    EXPECT_TRUE(started.empty());
+    harness.engine.play();
+    ASSERT_EQ(harness.engine.playbackState(), Engine::PlaybackState::Playing);
