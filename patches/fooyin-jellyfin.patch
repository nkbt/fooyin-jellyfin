+FOOYIN_AUDIOENGINE_REGULAR_TEST(AudioEngineTest, OccurrenceStartsOnlyAfterSourceOutputAndStopRetainsPosition)
+{
+    ensureCoreApplication();
+    EngineHarness harness{false};
